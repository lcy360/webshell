[Unit]
Description=Webshell browser terminal manager
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/webshell
Environment=HOST=127.0.0.1
Environment=PORT=4767
Environment=WEBSHELL_DATA_DIR=/var/lib/webshell
Environment=WEBSHELL_OUTPUT_FLUSH_MS=4
Environment=WEBSHELL_OUTPUT_FLUSH_BYTES=16384
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
