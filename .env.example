HOST=127.0.0.1
PORT=4767

# Set these before the first start to create deterministic credentials.
# If omitted, Webshell creates user "admin" and prints a random password.
WEBSHELL_USERNAME=admin
WEBSHELL_PASSWORD=change-me

# Optional: keep runtime state outside the repo.
# WEBSHELL_DATA_DIR=/var/lib/webshell
